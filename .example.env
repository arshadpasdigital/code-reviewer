NODE_ENV=development
PORT=3000
INNGEST_DEV=true

# GitHub App credentials
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=""

# AI review
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4.1-mini

DATABASE_URL="postgres://review_rabbit:password@localhost:5432/review_rabbit"
FIX_PROPOSAL_ENCRYPTION_KEY="replace-with-a-long-random-secret"
RUNNER_NODE_IMAGE=node:22-bookworm-slim
RUNNER_BUN_IMAGE=oven/bun:1
RUNNER_TIMEOUT_SECONDS=600
RUNNER_MAX_OUTPUT_BYTES=100000

# Required when using hosted Inngest; leave empty for local development.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
